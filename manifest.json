{
  "manifest_version": 3,
  "name": "Font Inspector",
  "description": "Inspect rendered typography from selected webpage text.",
  "version": "1.0.0",
  "icons": {
    "16": "src/logo/icon-16.png",
    "32": "src/logo/icon-32.png",
    "48": "src/logo/icon-48.png",
    "128": "src/logo/icon-128.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "windows"],
  "action": {
    "default_title": "Font Inspector",
    "default_icon": {
      "16": "src/logo/icon-16.png",
      "32": "src/logo/icon-32.png",
      "48": "src/logo/icon-48.png",
      "128": "src/logo/icon-128.png"
    },
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/popup/index.html",
  "background": {
    "service_worker": "src/background/context-menu.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/utils/typography.js",
        "src/content/inspector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/fonts/Archivo-VariableFont_wdth,wght.ttf"],
      "matches": ["<all_urls>"]
    }
  ]
}
